{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sangyo-joken",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "sangyo-joken.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["23 23 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sangyo-joken",
      "database_id": "4ee75a38-b7e2-429a-897a-13d7ee3ddb35",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
